diff --git a/backend/app/memory/conversation_memory.py b/backend/app/memory/conversation_memory.py
new file mode 100644
index 0000000..e56e10c
--- /dev/null
+++ b/backend/app/memory/conversation_memory.py
@@ -0,0 +1,117 @@
+import json
+from datetime import datetime
+from pathlib import Path
+
+
+class ConversationMemory:
+    """
+    Stores and manages conversation history.
+
+    Responsibilities:
+    - Load conversation
+    - Save conversation
+    - Add user messages
+    - Add assistant messages
+    - Return recent conversation
+    - Clear conversation
+    """
+
+    def __init__(
+        self,
+        memory_path: str = "backend/app/memory/conversation.json",
+    ):
+
+        self.memory_path = Path(memory_path)
+
+        if not self.memory_path.exists():
+
+            self.memory_path.parent.mkdir(
+                parents=True,
+                exist_ok=True,
+            )
+
+            self.memory_path.write_text(
+                "[]",
+                encoding="utf-8",
+            )
+
+        self.messages = self.load()
+
+    def load(self):
+
+        with open(
+            self.memory_path,
+            "r",
+            encoding="utf-8",
+        ) as file:
+
+            return json.load(file)
+
+    def save(self):
+
+        with open(
+            self.memory_path,
+            "w",
+            encoding="utf-8",
+        ) as file:
+
+            json.dump(
+                self.messages,
+                file,
+                indent=4,
+            )
+
+    def add_user_message(
+        self,
+        message: str,
+    ):
+
+        self.messages.append(
+            {
+                "role": "user",
+                "content": message,
+                "timestamp": datetime.now().isoformat(),
+            }
+        )
+
+        self.save()
+
+    def add_assistant_message(
+        self,
+        message: str,
+    ):
+
+        self.messages.append(
+            {
+                "role": "assistant",
+                "content": message,
+                "timestamp": datetime.now().isoformat(),
+            }
+        )
+
+        self.save()
+
+    def get_recent_history(
+        self,
+        max_messages: int = 10,
+    ) -> str:
+
+        history = self.messages[-max_messages :]
+
+        conversation = []
+
+        for message in history:
+
+            role = message["role"].capitalize()
+
+            conversation.append(
+                f"{role}: {message['content']}"
+            )
+
+        return "\n".join(conversation)
+
+    def clear(self):
+
+        self.messages = []
+
+        self.save()
